{
  "documentation": {
    "tiers": "One entry per medallion, keyed by the greed rank it belongs to. Rank 1 is the first medallion and rank 16 the last; the band names come from greed_ranks.json",
    "baseGreedCoins": "Greed coins an assassin killed in this medallion's vault pays, and the per-crate base the completion crate pays",
    "mobHealthDamageBonus": "Percent added to vault mob health and damage. Multiplicative with every other source",
    "crateLootBonus": "Percent added to the item count of completion crates",
    "greedCrateLootTier": "Which greed_crate_loot_N table the completion crate additionally rolls. 0 rolls none",
    "chestRollsBonus": "Percent added to the roll count of tiered chests. Barrels and treasure chests are not tiered and are unaffected",
    "trapDisarmPenalty": "Percent subtracted from trap disarming. A magnitude, so 33 means -33%",
    "mobSpawnBonus": "Percent added to the sustained vault mob population ceiling",
    "objectiveDifficultyBonus": "Percent added to objective difficulty. Reaches brutal boss pillars and bosses only, the one numeric difficulty axis in the game",
    "gates": "The medallion rank each behaviour switches on at. Vault Champion behaviours are tabled but not implemented",
    "spawn": "Assassin spawn chance per attempt is base * (1 + rankChanceStep * (rank - 1)), decaying by decayFactor per spawn and recovering over recoveryTicks"
  },
